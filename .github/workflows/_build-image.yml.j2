{% set e2e_image_targets = ["go-web", "rust-web"] %}
{% set e2e_sessions = ["wayland-sway"] %}
{% set e2e_enabled = image_target in e2e_image_targets and e2e_sessions | length > 0 %}
{% set e2e_matrix_sessions = e2e_sessions if e2e_sessions | length > 0 else ["disabled"] %}
name: build-image-<< image_target >>

on:
  workflow_dispatch:
  push:
    branches: [ master ]

concurrency:
  group: build-image-<< image_target >>
  cancel-in-progress: true

jobs:
  build:
    name: build-<< image_target >>
    runs-on: ubuntu-latest
    permissions:
      contents: read
      packages: write
    steps:
      - name: Free disk space
        run: |
          sudo rm -rf /usr/share/dotnet /usr/local/lib/android /opt/ghc || true
          docker system prune -af || true
          df -h

      # https://github.com/orgs/community/discussions/42479#discussioncomment-4484937
      # https://github.com/wph95/opentelemetry-demo-webstore/blob/ae08811157db7ba590a7c8dd6faa2cb9d1473bef/.github/workflows/release.yml#L24-L29
      # limit docker push image concurrency to 1
      # to avoid github package return 429 ratelimit error
      - name: Set docker upload concurrent
        run: |
          echo $'{"max-concurrent-downloads": 50, "max-concurrent-uploads": 2}' | sudo dd status=none of=/etc/docker/daemon.json
          sudo service docker restart

      # https://discourse.nixos.org/t/building-docker-image-in-github-actions-leads-to-skopeo-related-issues/40636/4
      - name: Fix dockerTools.pullImage issue
        run: |
          sudo chmod 755 /run/containers
          sudo mkdir -p "/run/containers/$(id -u runner)"
          sudo chown runner: "/run/containers/$(id -u runner)"

      - name: Checkout
        uses: actions/checkout@v7

      - name: Install Nix with official installer
        shell: bash
        run: |
          set -euxo pipefail

          sudo apt-get update
          sudo apt-get install -y xz-utils

          curl -L https://nixos.org/nix/install | sh -s -- --daemon

          echo "/nix/var/nix/profiles/default/bin" >> "$GITHUB_PATH"
          echo "NIX_REMOTE=daemon" >> "$GITHUB_ENV"

          . /nix/var/nix/profiles/default/etc/profile.d/nix-daemon.sh

          nix --version

      - name: Configure Nix
        shell: bash
        run: |
          set -euxo pipefail

          sudo sed -i \
            -e '/^experimental-features[[:space:]]*=/d' \
            -e '/^max-jobs[[:space:]]*=/d' \
            -e '/^substituters[[:space:]]*=/d' \
            -e '/^trusted-public-keys[[:space:]]*=/d' \
            -e '/^trusted-users[[:space:]]*=/d' \
            /etc/nix/nix.conf

          printf '%s\n' \
            "experimental-features = nix-command flakes" \
            "max-jobs = auto" \
            "trusted-users = root ${USER}" \
            | sudo tee -a /etc/nix/nix.conf

          sudo systemctl restart nix-daemon

          nix config show experimental-features
          nix config show substituters

      - name: Build reports
        run: |
          nix build --accept-flake-config .#images.<< image_target >>.reports --print-out-paths --no-link > report-path.txt
          cp -R "$(cat report-path.txt)" reports

      - name: Validate reports
        run: |
          nix build --accept-flake-config .#checks.x86_64-linux.reports-<< image_target >> --no-link

      - name: Upload reports
        uses: actions/upload-artifact@v7
        with:
          name: reports-<< image_target >>
          path: reports

      - name: Build OCI image artifact
        run: |
          nix build --accept-flake-config .#images.<< image_target >>.oci --print-out-paths --no-link > oci-path.txt

      - name: Validate OCI image artifact
        run: |
          nix build --accept-flake-config .#checks.x86_64-linux.artifact-image-<< image_target >> --no-link

      - name: Load OCI image
        run: |
          nix run --accept-flake-config .#load-<< image_target >>

      - name: Run smoke plan
        env:
          SMOKE_LOG_DIR: smoke-logs
        run: |
          nix run --accept-flake-config .#run-smoke-plan -- << image_target >>

      - name: Upload smoke logs
        if: always()
        uses: actions/upload-artifact@v7
        with:
          name: smoke-logs-<< image_target >>
          path: smoke-logs

      - name: Login to GHCR
        if: github.event_name == 'push' && github.ref == 'refs/heads/master'
        uses: docker/login-action@v4
        with:
          registry: ghcr.io
          username: ${{ github.actor }}
          password: ${{ secrets.GITHUB_TOKEN }}

      - name: Push image
        if: github.event_name == 'push' && github.ref == 'refs/heads/master'
        run: |
          image_ref="$(jq -r '.imageRef' reports/ci-plan.json)"
          mapfile -t publish_refs < <(jq -r '.publishRefs[]' reports/ci-plan.json)
          for publish_ref in "${publish_refs[@]}"; do
            if [ "$publish_ref" != "$image_ref" ]; then
              docker tag "$image_ref" "$publish_ref"
            fi
            docker push "$publish_ref"
          done
          docker inspect "$image_ref" --format='{{index .RepoDigests 0}}' > digest.txt

      - name: Upload digest
        if: github.event_name == 'push' && github.ref == 'refs/heads/master'
        uses: actions/upload-artifact@v7
        with:
          name: digest-<< image_target >>
          path: digest.txt

  e2e:
    name: e2e-<< image_target >>-${{ matrix.session }}
    needs: build
    if: ${{ << e2e_enabled | tojson >> }}
    runs-on: ubuntu-latest
    permissions:
      contents: read
    strategy:
      fail-fast: false
      matrix:
        session: << e2e_matrix_sessions | tojson >>
    steps:
      - name: Free disk space
        run: |
          sudo rm -rf /usr/share/dotnet /usr/local/lib/android /opt/ghc || true
          docker system prune -af || true
          df -h

      - name: Checkout
        uses: actions/checkout@v7

      - name: Install Nix with official installer
        shell: bash
        run: |
          set -euxo pipefail

          sudo apt-get update
          sudo apt-get install -y xz-utils

          curl -L https://nixos.org/nix/install | sh -s -- --daemon

          echo "/nix/var/nix/profiles/default/bin" >> "$GITHUB_PATH"
          echo "NIX_REMOTE=daemon" >> "$GITHUB_ENV"

          . /nix/var/nix/profiles/default/etc/profile.d/nix-daemon.sh

          nix --version

      - name: Configure Nix
        shell: bash
        run: |
          set -euxo pipefail

          sudo sed -i \
            -e '/^experimental-features[[:space:]]*=/d' \
            -e '/^max-jobs[[:space:]]*=/d' \
            -e '/^substituters[[:space:]]*=/d' \
            -e '/^trusted-public-keys[[:space:]]*=/d' \
            -e '/^trusted-users[[:space:]]*=/d' \
            /etc/nix/nix.conf

          printf '%s\n' \
            "experimental-features = nix-command flakes" \
            "max-jobs = auto" \
            "trusted-users = root ${USER}" \
            | sudo tee -a /etc/nix/nix.conf

          sudo systemctl restart nix-daemon

          nix config show experimental-features
          nix config show substituters

      - name: Enable KVM
        run: |
          if [ ! -e /dev/kvm ]; then
            echo "/dev/kvm is missing; e2e requires a KVM-capable runner" >&2
            exit 1
          fi
          sudo chmod 666 /dev/kvm
          ls -l /dev/kvm

      - name: Run e2e test
        run: |
          set -euo pipefail

          attr=".#e2e-vscode-<< image_target >>-${{ matrix.session }}"
          drv_path="$(
            nix path-info \
              --extra-experimental-features nix-command \
              --extra-experimental-features flakes \
              --derivation \
              "$attr"
          )"
          printf '%s\n' "$drv_path" > e2e-drv-path.txt

          set +e
          NO_COLOR=1 TERM=dumb nix build \
            --extra-experimental-features nix-command \
            --extra-experimental-features flakes \
            "$attr" \
            --print-out-paths \
            --no-link \
            >e2e-output-path.txt \
            2>e2e-build.stderr.log
          status="$?"
          set -e

          if [ "$status" -eq 0 ]; then
            output_path="$(tail -n1 e2e-output-path.txt)"
            test -n "$output_path"
            mkdir -p e2e-output
            if [ -d "$output_path" ]; then
              cp -R "$output_path"/. e2e-output/
            else
              cp -R "$output_path" e2e-output/
            fi
            exit 0
          fi

          mkdir -p e2e-logs
          cp e2e-build.stderr.log e2e-logs/
          NO_COLOR=1 TERM=dumb nix \
            --extra-experimental-features nix-command \
            --extra-experimental-features flakes \
            --log-format raw \
            log "$drv_path" \
            >"e2e-logs/$(basename "$drv_path").log" \
            2>&1 || true
          sed -r -i 's/\x1B\[[0-9;]*[mK]//g' e2e-logs/*.log
          exit "$status"

      - name: Upload e2e output
        if: success()
        uses: actions/upload-artifact@v7
        with:
          name: e2e-output-<< image_target >>-${{ matrix.session }}
          path: e2e-output
          if-no-files-found: error

      - name: Upload e2e nix logs
        if: failure()
        uses: actions/upload-artifact@v7
        with:
          name: e2e-nix-logs-<< image_target >>-${{ matrix.session }}
          path: e2e-logs
          if-no-files-found: warn
